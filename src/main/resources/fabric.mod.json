{
  "schemaVersion": 1,
  "id": "carbon",
  "version": "${version}",
  "name": "Carbon（碳）",
  "description": "GPU instancing for standard item models, dropped-item animation, glint, shadows and optional visual physics.",
  "authors": [
    "FirstSight,Colin_101(Fabric移植者)"
  ],
  "license": "MIT",
  "icon": "assets/carbon/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "first.carbon.Carbon"
    ],
    "modmenu": [
      "first.carbon.client.CarbonModMenu"
    ]
  },
  "mixins": [
    "carbon.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
